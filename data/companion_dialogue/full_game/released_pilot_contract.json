      "replies_sha256": "5c87a5d82e7b5b7ef104f7d3dade041d0fd7b27cb150ebd42491bec0b1a9d2f3"
    },
    {
      "id": 37,
      "key": "fortree_blocked",
      "sources": {
        "FortreeCity_Text_SomethingBlockingGym": {
          "path": "data/maps/FortreeCity/scripts.inc",
          "text": "I want to go to the POKéMON GYM,\\nbut something's blocking the way.\\pAfter all the bother I went through\\ntraining on ROUTE 120…$",
          "sha256": "179a51d47f8cbbf1a74dccaaf6e7555205ec4b775a9d08d84a9de779be53e790"
        }
      },
      "replies_sha256": "4e6768d6f1dc41e5b4e256abf7e5f8959fba3ef711216f88cac06b84288eeb0e"
    },
    {
      "id": 38,
      "key": "aqua_loot",
      "sources": {
        "LilycoveCity_Text_MovedLootIntoHideoutToday": {
          "path": "data/maps/LilycoveCity/scripts.inc",
          "text": "Fufufu…\\pWe moved more loot into our secret\\nHIDEOUT today…\\pWh-who are you?!\\nI was just talking to myself!$",
          "sha256": "3719bcb41fd07e07071a538fd71f7f7507720c37792f8ca1854eb2657efd984d"
        }
