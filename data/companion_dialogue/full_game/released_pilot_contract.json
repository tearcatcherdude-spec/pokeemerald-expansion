      "sources": {
        "PetalburgCity_Text_AreYouRookieTrainer": {
          "path": "data/maps/PetalburgCity/scripts.inc",
          "text": "Hiya! Are you maybe…\\nA rookie TRAINER?\\pDo you know what POKéMON TRAINERS\\ndo when they reach a new town?\\pThey first check what kind of GYM\\nis in the town.$",
