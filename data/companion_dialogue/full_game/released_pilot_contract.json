        "DewfordTown_Text_TinyIslandCommunity": {
          "path": "data/maps/DewfordTown/scripts.inc",
          "text": "DEWFORD is a tiny island community.\\nIf something gets trendy here,\\leveryone picks up on it right away.$",
          "sha256": "4b35b1d1cbbe130555406609b1d3d492b57abed298bb77cb4512a79d8b204d2f"
        }
      },
      "replies_sha256": "a85347c00161a71f912ac59cdee1861572a25542a2c89925fd8f40eb0ca2dade"
    },
    {
      "id": 36,
      "key": "devon_products",
      "sources": {
        "RustboroCity_Text_WeShortenItToDevon": {
          "path": "data/maps/RustboroCity/scripts.inc",
          "text": "The DEVON CORPORATION…\\nWe all just shorten it to DEVON.\\pThat company makes all sorts of\\nconvenient products.$",
          "sha256": "9eb699303885ffd303dce875fb66623ff51f3edd6b451e7175ad6148f88962b1"
