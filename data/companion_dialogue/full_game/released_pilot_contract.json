        },
        "OldaleTown_Text_WaitDontComeInHere": {
          "path": "data/maps/OldaleTown/scripts.inc",
          "text": "Aaaaah! Wait!\\nPlease don't come in here.\\pI just discovered the footprints of\\na rare POKéMON!\\pWait until I finish sketching\\nthem, okay?$",
