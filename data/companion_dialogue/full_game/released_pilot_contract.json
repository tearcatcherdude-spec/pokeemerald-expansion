    },
    {
      "id": 41,
      "key": "garden_repel",
      "sources": {
        "PewterCity_Text_SprayingRepelToKeepWildMonsOut": {
          "path": "data/kanto/maps/PewterCity_Frlg/scripts.inc",
          "text": "I'm spraying REPEL to keep wild\\nPOKéMON out of my garden!$",
          "sha256": "3402f7f61378e0feafb50eb03abd88c23779f592a894f3a6a409342e5cc0b997"
