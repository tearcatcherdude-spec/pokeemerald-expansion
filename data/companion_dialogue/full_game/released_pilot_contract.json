      "replies_sha256": "b0c6fbf174efe7ccde48ea4e788d407548bcb09f1edaa07f14bc0befae49490c"
    },
    {
      "id": 39,
      "key": "sootopolis_steps",
      "sources": {
        "SootopolisCity_Text_PhysicallyFitLivingHere": {
          "path": "data/maps/SootopolisCity/scripts.inc",
          "text": "Diving in the sea. Climbing up and\\ndown stairs all the time…\\pIf you live in this town, you end up\\ngetting physically fit.$",
          "sha256": "2e0ca83219fca8e1fd0ab68b1380dbddc1abe2529b22b8274b5756eaf0f05cac"
        }
      },
      "replies_sha256": "8d780333a02550660963e2bd0684405e669cfb0403b03ff18b385edf046ba947"
    },
    {
      "id": 40,
      "key": "moon_rumour",
      "sources": {
        "PewterCity_Text_ClefairyCameFromMoon": {
          "path": "data/kanto/maps/PewterCity_Frlg/scripts.inc",
          "text": "CLEFAIRY came from the moon.\\nThat's what the rumor is.\\pThey appeared after MOON STONES\\nfell on MT. MOON.$",
          "sha256": "a805c52fc9eca6738128e810aef9a1ff53951d3366329531955e375d6ff9e0f1"
