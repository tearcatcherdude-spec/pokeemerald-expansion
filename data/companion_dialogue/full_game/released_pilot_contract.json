      "key": "oldale_footprints_search",
      "sources": {
        "OldaleTown_Text_DiscoveredFootprints": {
          "path": "data/maps/OldaleTown/scripts.inc",
          "text": "I just discovered the footprints of\\na rare POKéMON!\\pWait until I finish sketching\\nthem, okay?$",
