      "sources": {
        "OldaleTown_House2_Text_YoullGoFurtherWithStrongPokemon": {
          "path": "data/maps/OldaleTown_House2/scripts.inc",
          "text": "If the POKéMON with you become\\nstronger, you'll be able to go farther\\laway from here.$",
