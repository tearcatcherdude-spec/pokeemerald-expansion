      "key": "harbour_pollution",
      "sources": {
        "VermilionCity_Text_GrimerMultipliesInSludge": {
          "path": "data/kanto/maps/VermilionCity_Frlg/scripts.inc",
          "text": "We're careful about pollution here.\\pWe've heard GRIMER multiplies in\\ntoxic sludge.$",
