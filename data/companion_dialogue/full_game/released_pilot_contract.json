      "key": "lavender_white_hand",
      "sources": {
        "LavenderTown_Text_JustImaginingWhiteHand": {
          "path": "data/kanto/maps/LavenderTown_Frlg/scripts.inc",
          "text": "Hahaha, I guess not.\\pThat white hand on your shoulder…\\nI'm just imagining it.$",
