	lock
	faceplayer
	setwildbattle SPECIES_ELECTRODE, 34
	waitse
	playmoncry SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setflag KANTO_FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	clearflag KANTO_FLAG_SYS_CTRL_OBJ_DELETE
	specialvar KANTO_VAR_RESULT, GetBattleOutcome
	goto_if_eq KANTO_VAR_RESULT, B_OUTCOME_WON, PowerPlant_EventScript_FoughtElectrode2
	goto_if_eq KANTO_VAR_RESULT, B_OUTCOME_RAN, PowerPlant_EventScript_FoughtElectrode2
	goto_if_eq KANTO_VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, PowerPlant_EventScript_FoughtElectrode2
	setflag KANTO_FLAG_FOUGHT_POWER_PLANT_ELECTRODE_2
