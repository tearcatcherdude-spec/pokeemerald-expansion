KantoCinnabarIsland_PokemonLab_Lounge_MapScripts::
	.byte 0

CinnabarIsland_PokemonLab_Lounge_EventScript_Scientist::
	msgbox CinnabarIsland_PokemonLab_Lounge_Text_FoundFossilInMtMoon, MSGBOX_NPC
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_Clifton::
	lock
	faceplayer
	setvar KANTO_VAR_0x8008, INGAME_TRADE_ELECTRODE
	call EventScript_GetInGameTradeSpeciesInfo
	goto_if_set KANTO_FLAG_DID_ESPHERE_TRADE, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonAlreadyTraded
	msgbox Trade_Text_DoYouHaveMonWouldYouTradeForMon, MSGBOX_YESNO
	goto_if_eq KANTO_VAR_RESULT, NO, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonDeclineTrade
	call EventScript_ChooseMonForInGameTrade
	goto_if_ge KANTO_VAR_0x8004, PARTY_SIZE, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonDeclineTrade
	call EventScript_GetInGameTradeSpecies
	goto_if_ne KANTO_VAR_RESULT, KANTO_VAR_0x8009, CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonNotRequestedMon
	call EventScript_DoInGameTrade
	msgbox Trade_Text_Thanks
	setflag KANTO_FLAG_DID_ESPHERE_TRADE
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonDeclineTrade::
	msgbox Trade_Text_WellIfYouDontWantTo
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonNotRequestedMon::
	bufferspeciesname STR_VAR_1, KANTO_VAR_0x8009
	msgbox Trade_Text_ThisIsntMon
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_CliftonAlreadyTraded::
	msgbox Trade_Text_HasTradedMonGrownStronger
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_Norma::
	lock
	faceplayer
	setvar KANTO_VAR_0x8008, INGAME_TRADE_TANGELA
	copyvar KANTO_VAR_0x8004, KANTO_VAR_0x8008
	specialvar KANTO_VAR_RESULT, GetInGameTradeSpeciesInfo
	copyvar KANTO_VAR_0x8009, KANTO_VAR_RESULT
	goto_if_set KANTO_FLAG_DID_TANGENY_TRADE, CinnabarIsland_PokemonLab_Lounge_EventScript_NormaAlreadyTraded
	msgbox Trade_Text_DoYouHaveMonWantToTradeForMon, MSGBOX_YESNO
	goto_if_eq KANTO_VAR_RESULT, NO, CinnabarIsland_PokemonLab_Lounge_EventScript_NormaDeclineTrade
	special ChoosePartyMon
	copyvar KANTO_VAR_0x800A, KANTO_VAR_0x8004
	goto_if_ge KANTO_VAR_0x8004, PARTY_SIZE, CinnabarIsland_PokemonLab_Lounge_EventScript_NormaDeclineTrade
	copyvar KANTO_VAR_0x8005, KANTO_VAR_0x800A
	specialvar KANTO_VAR_RESULT, GetTradeSpecies
	copyvar KANTO_VAR_0x800B, KANTO_VAR_RESULT
	goto_if_ne KANTO_VAR_RESULT, KANTO_VAR_0x8009, CinnabarIsland_PokemonLab_Lounge_EventScript_NormaNotRequestedMon
	copyvar KANTO_VAR_0x8004, KANTO_VAR_0x8008
	copyvar KANTO_VAR_0x8005, KANTO_VAR_0x800A
	special CreateInGameTradePokemon
	special DoInGameTradeScene
	msgbox Trade_Text_ThanksYoureAPal
	setflag KANTO_FLAG_DID_TANGENY_TRADE
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_NormaDeclineTrade::
	msgbox Trade_Text_ThatsTooBad
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_NormaNotRequestedMon::
	bufferspeciesname STR_VAR_1, KANTO_VAR_0x8009
	msgbox Trade_Text_ThisIsNoMon
	release
	call Pip_EventScript_NPCReaction
	end

CinnabarIsland_PokemonLab_Lounge_EventScript_NormaAlreadyTraded::
	msgbox Trade_Text_HowIsMyOldMon
	release
	call Pip_EventScript_NPCReaction
	end

